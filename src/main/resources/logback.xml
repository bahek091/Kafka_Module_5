<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Без этого файла logback пишет DEBUG клиента Kafka, и вывод продюсера/консьюмера теряется -->
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
